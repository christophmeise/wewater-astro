---
/**
 * Site footer: wave into the grey-blue band, social links, three columns (Hilf uns /
 * Informationen / Spende jetzt with the bank details), then logo, copyright and legal links.
 * Internal links are localised; targets are copied from the old site's Footer.tsx.
 */
import { separatorVariants } from '@heroui/styles';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import Logo from '@/components/ui/Logo.astro';
import { localizePath, useTranslations, type Locale, type UiKey } from '@/i18n';
import { SHOP_URL } from './navigation';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const l = (path: string) => localizePath(path, locale);
const year = new Date().getFullYear();

const SOCIAL: { name: string; href: string; icon: IconName }[] = [
  { name: 'Facebook', href: 'https://www.facebook.com/wewater.org/', icon: 'facebook' },
  { name: 'Instagram', href: 'https://www.instagram.com/wewater_org/', icon: 'instagram' },
  { name: 'YouTube', href: 'https://www.youtube.com/channel/UC3zOjWWL5drSnoxzcj3-jqw', icon: 'youtube' },
];

const COLUMNS: { heading: UiKey; links: { label: UiKey; href: string }[] }[] = [
  {
    heading: 'footer.helpUs',
    links: [
      { label: 'footer.howToDonate', href: l('/spenden/') },
      { label: 'footer.howToSupport', href: l('/unterstuetzen/') },
      { label: 'footer.buyFilters', href: SHOP_URL },
      { label: 'footer.donationReceipt', href: l('/spenden/') },
    ],
  },
  {
    heading: 'footer.information',
    links: [
      { label: 'footer.press', href: l('/presse/') },
      { label: 'footer.faq', href: l('/faq/') },
      { label: 'footer.questions', href: 'mailto:hi@wewater.org' },
    ],
  },
];

const headingClass = 'text-sm font-semibold uppercase tracking-widest';
---

<footer>
  <svg
    class="fill-background-secondary -mb-px block aspect-[1440/130] h-auto w-full"
    viewBox="0 0 1440 130"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M-0.5 149L21.1 140.722C42.7 132.444 87.1 115.889 130.3 113.13C173.5 110.37 217.9 121.407 261.1 118.648C305.5 115.889 348.7 99.3333 391.9 85.537C436.3 71.7407 479.5 60.7037 522.7 66.2222C567.1 71.7407 610.3 93.8148 653.5 107.611C697.9 121.407 741.1 126.926 785.5 118.648C828.7 110.37 871.9 88.2963 916.3 66.2222C959.5 44.1481 1002.7 22.0741 1047.1 19.3148C1090.3 16.5556 1133.5 33.1111 1177.9 38.6296C1221.1 44.1481 1265.5 38.6296 1308.7 30.3519C1351.9 22.0741 1396.3 11.037 1417.9 5.51852L1439.5 0V149H-0.5Z"
    ></path>
  </svg>

  <div class="bg-background-secondary">
    <div class="container-page flex flex-col gap-12 py-(--space-section)">
      <div class="flex flex-col gap-4">
        <p class="font-heading text-2xl font-semibold">WeWater</p>
        <ul class="text-accent flex gap-3 text-2xl" aria-label={t('footer.social')}>
          {
            SOCIAL.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class="hover:text-link block rounded-md transition-[translate,color] hover:-translate-y-0.5"
                >
                  <Icon name={s.icon} label={`${s.name} ${t('nav.newTab')}`} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid gap-10 md:grid-cols-3 md:gap-8">
        {
          COLUMNS.map((column) => (
            <div class="flex flex-col gap-4">
              <h2 class={headingClass}>{t(column.heading)}</h2>
              <ul class="flex flex-col gap-2">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-muted hover:text-foreground transition-colors">
                      {t(link.label)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="flex flex-col gap-4">
          <h2 class={headingClass}>{t('footer.donateNow')}</h2>
          <p>
            WeWater gUG<br />
            Bank für Sozialwirtschaft<br />
            IBAN: DE90 3702 0500 0001 6026 01<br />
            BIC-/SWIFT: BFSWDE33XXX
          </p>
          <p class="text-muted text-sm">{t('footer.bankNote')}</p>
        </div>
      </div>
    </div>

    <div class={separatorVariants()} role="presentation"></div>

    <div class="container-page flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-4">
      <a href={l('/')} class="rounded-2xl">
        <Logo alt={t('nav.home')} class="size-12" />
      </a>
      <p class="text-muted order-last w-full text-sm md:order-none md:w-auto">© {year} WeWater gUG. {t('footer.rights')}</p>
      <p class="flex items-center gap-3">
        <a href={l('/impressum/')} class="hover:text-link">{t('footer.imprint')}</a>
        <span aria-hidden="true" class="text-muted">|</span>
        <a href={l('/dataprotection/')} class="hover:text-link">{t('footer.privacy')}</a>
      </p>
    </div>
  </div>
</footer>
