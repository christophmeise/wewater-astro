---
/**
 * Site footer: wave, social links, three link columns (Hilf uns / Informationen / Spende jetzt
 * with the bank details), then logo, copyright and legal links. All internal links are localised.
 * Link targets are copied from the old site's Footer.tsx.
 */
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import Logo from '@/components/ui/Logo.astro';
import { localizePath, useTranslations, type Locale, type UiKey } from '@/i18n';
import { SHOP_URL } from './navigation';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const l = (path: string) => localizePath(path, locale);
const year = new Date().getFullYear();

const SOCIAL: { name: string; href: string; icon: IconName }[] = [
  { name: 'Facebook', href: 'https://www.facebook.com/wewater.org/', icon: 'facebook' },
  { name: 'Instagram', href: 'https://www.instagram.com/wewater_org/', icon: 'instagram' },
  { name: 'YouTube', href: 'https://www.youtube.com/channel/UC3zOjWWL5drSnoxzcj3-jqw', icon: 'youtube' },
];

const COLUMNS: { heading: UiKey; links: { label: UiKey; href: string }[] }[] = [
  {
    heading: 'footer.helpUs',
    links: [
      { label: 'footer.howToDonate', href: l('/spenden/') },
      { label: 'footer.howToSupport', href: l('/unterstuetzen/') },
      { label: 'footer.buyFilters', href: SHOP_URL },
      { label: 'footer.donationReceipt', href: l('/spenden/') },
    ],
  },
  {
    heading: 'footer.information',
    links: [
      { label: 'footer.press', href: l('/presse/') },
      { label: 'footer.faq', href: l('/faq/') },
      { label: 'footer.questions', href: 'mailto:hi@wewater.org' },
    ],
  },
];
---

<footer class="site-footer">
  <svg class="site-footer__wave" viewBox="0 0 1440 130" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M-0.500244 149L21.0998 140.722C42.6998 132.444 87.0998 115.889 130.3 113.13C173.5 110.37 217.9 121.407 261.1 118.648C305.5 115.889 348.7 99.3333 391.9 85.537C436.3 71.7407 479.5 60.7037 522.7 66.2222C567.1 71.7407 610.3 93.8148 653.5 107.611C697.9 121.407 741.1 126.926 785.5 118.648C828.7 110.37 871.9 88.2963 916.3 66.2222C959.5 44.1481 1002.7 22.0741 1047.1 19.3148C1090.3 16.5556 1133.5 33.1111 1177.9 38.6296C1221.1 44.1481 1265.5 38.6296 1308.7 30.3519C1351.9 22.0741 1396.3 11.037 1417.9 5.51852L1439.5 1.90735e-06V149H-0.500244Z"
    ></path>
  </svg>

  <div class="site-footer__main">
    <div class="container">
      <div class="site-footer__brand">
        <p class="site-footer__name">WeWater</p>
        <ul class="site-footer__social" aria-label={t('footer.social')}>
          {
            SOCIAL.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener" class="site-footer__social-link">
                  <Icon name={s.icon} label={`${s.name} ${t('nav.newTab')}`} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__columns">
        {
          COLUMNS.map((column) => (
            <div class="site-footer__column">
              <h2 class="site-footer__heading">{t(column.heading)}</h2>
              <ul class="site-footer__links">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{t(link.label)}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="site-footer__column">
          <h2 class="site-footer__heading">{t('footer.donateNow')}</h2>
          <p class="site-footer__bank">
            WeWater gUG<br />
            Bank für Sozialwirtschaft<br />
            IBAN: DE90&nbsp;3702&nbsp;0500&nbsp;0001&nbsp;6026&nbsp;01<br />
            BIC-/SWIFT: BFSWDE33XXX
          </p>
          <p class="site-footer__bank">{t('footer.bankNote')}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-grid">
      <a href={l('/')} class="site-footer__logo">
        <Logo alt={t('nav.home')} />
      </a>
      <p class="site-footer__copyright">© {year}, WeWater gUG. {t('footer.rights')}</p>
      <p class="site-footer__legal">
        <a href={l('/impressum/')}>{t('footer.imprint')}</a>
        <span aria-hidden="true">|</span>
        <a href={l('/dataprotection/')}>{t('footer.privacy')}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4.5rem;
    color: var(--color-dark);
  }

  .site-footer__wave {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 130;
    margin-bottom: -1px;
    color: var(--color-bg-secondary);
  }

  .site-footer__main {
    padding-block: 6em;
    background: var(--color-bg-secondary);
  }

  .site-footer__name {
    margin: 0 0 18px;
    font-size: 24px;
    font-weight: 600;
  }

  .site-footer__social {
    display: flex;
    gap: 0.5rem;
    margin: 0 0 36px;
    padding: 0;
    color: var(--color-primary);
    font-size: 21px;
    list-style: none;
  }

  .site-footer__social-link {
    display: block;
    color: inherit;
    transition: transform 0.2s ease-in-out;
  }

  .site-footer__social-link:is(:hover, :focus-visible) {
    transform: translateY(-2px);
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 2rem;
  }

  .site-footer__heading {
    margin: 0 0 14px;
    color: #343a40;
    font-size: 14px;
    font-weight: 700;
    line-height: 18px;
    letter-spacing: 0.1em;
  }

  .site-footer__links {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    color: #5f6368;
  }

  .site-footer__links a:hover {
    color: var(--color-dark);
  }

  .site-footer__bank {
    margin-bottom: 1.25em;
  }

  .site-footer__bottom {
    padding-block: 1rem;
    border-top: 1px solid rgb(0 13 62 / 20%);
    background: var(--color-bg-secondary);
  }

  .site-footer__bottom-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
  }

  .site-footer__logo {
    justify-self: start;
  }

  .site-footer__copyright {
    margin: 0;
    text-align: center;
  }

  .site-footer__legal {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    margin: 0;
  }

  .site-footer__legal a {
    color: inherit;
  }

  @media (width <= 767px) {
    .site-footer__columns {
      grid-template-columns: 1fr;
    }

    .site-footer__bottom {
      padding-block: 0;
    }

    .site-footer__bottom-grid {
      grid-template-columns: auto 1fr;
    }

    .site-footer__logo {
      --logo-size: 44px;
    }

    .site-footer__copyright {
      display: none;
    }
  }
</style>
