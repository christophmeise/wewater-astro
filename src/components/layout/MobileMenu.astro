---
/**
 * Navigation for phones and tablets (<1024px): a top bar with the logo and a burger button
 * that opens a full-screen menu (with the Filtersysteme sub-pages, the language switcher and
 * the "Ich will helfen!" button). Rendered inside <Header>.
 *
 * The burger is a <button aria-expanded aria-controls>; a few lines of script toggle it and
 * close the menu on Escape. Without JavaScript the burger is hidden and the menu is shown as a
 * plain list of links below the bar (see the html:not(.js) rules and BaseLayout's js flag).
 */
import Button from '@/components/ui/Button.astro';
import Logo from '@/components/ui/Logo.astro';
import { localizePath, useTranslations, type Locale } from '@/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { DONATE_PATH, NAV_ITEMS, linkState } from './navigation';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>> | undefined;
}

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
---

<div class="mobile-nav" data-mobile-nav>
  <div class="mobile-nav__bar">
    <a class="mobile-nav__logo" href={localizePath('/', locale)}>
      <Logo alt={t('nav.home')} size={44} loading="eager" />
    </a>
    <button class="mobile-nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-nav-menu" data-mobile-nav-toggle>
      <span class="visually-hidden">{t('nav.menu')}</span>
      <svg class="burger" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <path
          class="burger__line burger__line--1"
          d="M 20,29.000046 H 80.00031 C 80.000231,29.000046 94.498839,28.817352 94.532987,66.711331 94.543142,77.980673 90.966081,81.670246 85.259173,81.668997 79.552261,81.667751 75.000211,74.999942 75.000211,74.999942 L 25.000021,25.000058"
        ></path>
        <path class="burger__line burger__line--2" d="M 20,50 H 80"></path>
        <path
          class="burger__line burger__line--3"
          d="M 20,70.999954 H 80.000231 C 80.000231,70.999954 94.498839,71.182648 94.532987,33.288669 94.543142,22.019327 90.966081,18.329754 85.259173,18.331003 79.552261,18.332249 75.000211,25.000058 75.000211,25.000058 L 25.000021,74.999942"
        ></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-nav-menu" class="mobile-nav__menu" aria-label={t('nav.label')}>
    <ul class="mobile-nav__list">
      {
        NAV_ITEMS.map((item) => {
          const state = linkState(pathname, item.path, item.sectionPaths);
          return (
            <li>
              <a
                class:list={['mobile-nav__link', { 'is-active': state === 'page' }]}
                href={item.external ? item.path : localizePath(item.path, locale)}
                aria-current={state === 'page' ? 'page' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
              >
                {t(item.label)}
                {item.external && <span class="visually-hidden"> {t('nav.newTab')}</span>}
              </a>
              {item.children && (
                <ul class="mobile-nav__sublist">
                  {item.children
                    .filter((child) => child.path !== item.path)
                    .map((child) => {
                      const childState = linkState(pathname, child.path);
                      return (
                        <li>
                          <a
                            class:list={['mobile-nav__link', 'mobile-nav__link--sub', { 'is-active': childState === 'page' }]}
                            href={localizePath(child.path, locale)}
                            aria-current={childState === 'page' ? 'page' : undefined}
                          >
                            {t(child.label)}
                          </a>
                        </li>
                      );
                    })}
                </ul>
              )}
            </li>
          );
        })
      }
      <li class="mobile-nav__row">
        <LanguageSwitcher locale={locale} alternates={alternates} placement="inline" />
      </li>
      <li class="mobile-nav__row">
        <Button href={localizePath(DONATE_PATH, locale)} size="small" icon="tint" fluid>{t('nav.cta')}</Button>
      </li>
    </ul>
  </nav>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-mobile-nav-toggle]');
  if (root && toggle) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      root.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('mobile-nav-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    // Close when the layout switches to the desktop header.
    matchMedia('(width >= 1024px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .mobile-nav {
    display: block;
  }

  @media (width >= 1024px) {
    .mobile-nav {
      display: none;
    }
  }

  .mobile-nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    padding-inline: 18px;
    border-bottom: 1px solid rgb(34 36 38 / 15%);
    background: rgb(255 255 255 / 80%);
    box-shadow: 0 1px 2px 0 rgb(34 36 38 / 15%);
    backdrop-filter: saturate(180%) blur(20px);
  }

  .mobile-nav__logo {
    display: block;
  }

  .mobile-nav__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -5px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-dark);
    cursor: pointer;
  }

  .burger {
    width: 34px;
    height: 34px;
  }

  .burger__line {
    fill: none;
    stroke: currentColor;
    stroke-width: 6;
    transition:
      stroke-dasharray 600ms cubic-bezier(0.4, 0, 0.2, 1),
      stroke-dashoffset 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .burger__line--1,
  .burger__line--3 {
    stroke-dasharray: 60 207;
  }

  .burger__line--2 {
    stroke-dasharray: 60 60;
  }

  .is-open .burger__line--1,
  .is-open .burger__line--3 {
    stroke-dasharray: 90 207;
    stroke-dashoffset: -134;
  }

  .is-open .burger__line--2 {
    stroke-dasharray: 1 60;
    stroke-dashoffset: -30;
  }

  /* Menu panel: hidden until opened when JS runs, a plain visible list without JS. */
  .mobile-nav__menu {
    background: var(--color-bg);
  }

  :global(html.js) .mobile-nav__menu {
    position: fixed;
    inset: var(--header-height) 0 0;
    display: none;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  :global(html.js) .is-open .mobile-nav__menu {
    display: block;
  }

  :global(html:not(.js)) .mobile-nav__toggle {
    display: none;
  }

  :global(html.mobile-nav-open) {
    overflow: hidden;
  }

  .mobile-nav__list,
  .mobile-nav__sublist {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-nav__link,
  .mobile-nav__row {
    display: block;
    padding: 0.93em 18px;
    border-top: 1px solid rgb(0 0 0 / 10%);
    color: #0d0c22;
    font-size: 16px;
    line-height: 1;
  }

  .mobile-nav__link:hover,
  .mobile-nav__link.is-active {
    background: rgb(0 0 0 / 5%);
    text-decoration: none;
  }

  .mobile-nav__link--sub {
    position: relative;
    padding-left: 50px;
  }

  .mobile-nav__link--sub::before {
    position: absolute;
    top: 50%;
    left: 35px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
    content: '';
    translate: 0 -50%;
  }
</style>
