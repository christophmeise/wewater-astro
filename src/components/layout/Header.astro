---
/**
 * Site header (the page's banner landmark), fixed to the top of the viewport and translucent,
 * so hero photos run underneath it like on the old site.
 *
 * - Desktop (≥1024px): logo, main navigation with the "Filtersysteme" mega-menu, the
 *   "Ich will helfen!" button and the language switcher.
 *   The mega-menu opens on hover and on keyboard focus (:focus-within) – no JS needed.
 *   Escape closes it (small script below).
 * - Phones and tablets (<1024px): <MobileMenu> (top bar + burger + full-screen menu).
 *
 * The link to the current page gets aria-current="page"; its section (e.g. "Blog" on a blog
 * post) is highlighted too. Both work in every language.
 */
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import { localizePath, useTranslations, type Locale } from '@/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileMenu from './MobileMenu.astro';
import { DONATE_PATH, NAV_ITEMS, linkState } from './navigation';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>> | undefined;
}

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="desktop-nav">
    <div class="container desktop-nav__bar">
      <a class="desktop-nav__logo" href={localizePath('/', locale)}>
        <Logo alt={t('nav.home')} loading="eager" />
      </a>

      <nav class="desktop-nav__nav" aria-label={t('nav.label')}>
        <ul class="desktop-nav__list">
          {
            NAV_ITEMS.map((item) => {
              const state = linkState(pathname, item.path, item.sectionPaths);
              const href = item.external ? item.path : localizePath(item.path, locale);
              return (
                <li class:list={['desktop-nav__item', { 'has-mega': item.children }]} data-mega={item.children ? '' : undefined}>
                  <a
                    class:list={['desktop-nav__link', { 'is-active': state }]}
                    href={href}
                    aria-current={state === 'page' ? 'page' : undefined}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener' : undefined}
                  >
                    {t(item.label)}
                    {item.external && <span class="visually-hidden"> {t('nav.newTab')}</span>}
                  </a>
                  {item.children && (
                    <div class="mega">
                      <ul class="mega__panel">
                        {item.children.map((child) => {
                          const childState = linkState(pathname, child.path);
                          return (
                            <li class:list={['mega__item', { 'mega__item--icon': child.icon }]}>
                              <a
                                class="mega__link"
                                href={localizePath(child.path, locale)}
                                aria-current={childState === 'page' ? 'page' : undefined}
                              >
                                {child.icon && (
                                  <span class="mega__circle">
                                    <img src={child.icon.src} alt="" width="32" height="32" loading="lazy" decoding="async" />
                                  </span>
                                )}
                                <span class="mega__text">
                                  <span class="mega__title">
                                    {t(child.label)}
                                    {!child.icon && <Icon name="arrow-small-right" class="mega__arrow" />}
                                  </span>
                                  <span class="mega__description">{t(child.description)}</span>
                                </span>
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="desktop-nav__actions">
        <Button href={localizePath(DONATE_PATH, locale)} size="small" shadow hoverAnimate>{t('nav.cta')}</Button>
        <LanguageSwitcher locale={locale} alternates={alternates} />
      </div>
    </div>
  </div>

  <MobileMenu locale={locale} alternates={alternates} />
</header>

<script>
  // Escape closes the hover/focus mega-menu (WCAG 1.4.13) until the pointer or focus leaves it.
  for (const item of document.querySelectorAll<HTMLElement>('[data-mega]')) {
    const reset = () => item.removeAttribute('data-dismissed');
    item.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      item.setAttribute('data-dismissed', '');
      item.querySelector<HTMLElement>('a')?.focus();
    });
    item.addEventListener('mouseleave', reset);
    item.addEventListener('focusout', (event) => {
      if (!item.contains(event.relatedTarget as Node | null)) reset();
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
  }

  /* Without JS the mobile menu is a plain list in the page flow (see MobileMenu). */
  @media (width <= 1023px) {
    :global(html:not(.js)) .site-header {
      position: static;
    }
  }

  /* ---------- Desktop bar ---------- */
  .desktop-nav {
    display: none;
    background: rgb(255 255 255 / 60%);
    box-shadow: 0 3px 7px 2px rgb(0 0 0 / 7%);
    backdrop-filter: saturate(180%) blur(40px);
  }

  @media (width >= 1024px) {
    .desktop-nav {
      display: block;
    }
  }

  .desktop-nav__bar {
    display: flex;
    gap: 1rem;
    align-items: center;
    height: var(--header-height);
  }

  .desktop-nav__logo {
    display: block;
    flex-shrink: 0;
  }

  .desktop-nav__list {
    display: flex;
    gap: 0.75rem;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav__nav {
    align-self: stretch;
  }

  .desktop-nav__item {
    display: flex;
    align-items: center;
  }

  .desktop-nav__link {
    padding: 0.8em 0.95em;
    border-radius: 4px;
    color: #0d0c22;
    font-size: 16px;
    line-height: 1;
  }

  .desktop-nav__link:hover,
  .desktop-nav__link.is-active,
  .has-mega:hover > .desktop-nav__link {
    background: rgb(0 0 0 / 5%);
    text-decoration: none;
  }

  .desktop-nav__actions {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    margin-left: auto;
  }

  /* ---------- Mega-menu ---------- */
  .has-mega {
    position: relative;
  }

  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    display: none;
    padding-top: 7px;
  }

  .has-mega:is(:hover, :focus-within):not([data-dismissed]) .mega {
    display: block;
  }

  .mega__panel {
    width: 490px;
    margin: 0;
    padding: 0.25rem 0 0.5rem;
    border-radius: 6px;
    background: var(--color-bg);
    box-shadow:
      0 50px 100px -20px rgb(50 50 93 / 25%),
      0 30px 60px -30px rgb(0 0 0 / 30%);
    list-style: none;
  }

  .mega__link {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 1rem;
    color: inherit;
  }

  .mega__link:hover {
    background: #eff9fd;
    text-decoration: none;
  }

  .mega__circle {
    display: grid;
    flex: 0 0 48px;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .mega__circle img {
    width: 32px;
    height: 32px;
  }

  .mega__text {
    display: grid;
    gap: 2px;
  }

  .mega__title {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    color: var(--color-primary-text);
    font-size: 18px;
    font-weight: 600;
  }

  .mega__description {
    color: #5c6b80;
    font-size: 14px;
  }

  .mega__link :global(.mega__arrow) {
    font-size: 28px;
    opacity: 0;
  }

  .mega__link:is(:hover, :focus-visible) :global(.mega__arrow) {
    opacity: 1;
  }
</style>
