---
/**
 * Language switcher: the current language (flag + name) opens a small list of plain links
 * to the same page in every language. Works without JavaScript (<details>); a few lines of
 * script close it on Escape or a click elsewhere.
 *
 * alternates: locale -> path of this page in that language (same prop as BaseLayout/Seo).
 * Omitted = the page exists in every language under the same path. A language missing from
 * `alternates` links to that language's home page.
 */
import { LOCALES, localizePath, unlocalizePath, useTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>> | undefined;
  /** dropdown: list floats below the toggle (header). inline: list opens in place (mobile menu). */
  placement?: 'dropdown' | 'inline' | undefined;
}

const { locale, alternates, placement = 'dropdown' } = Astro.props;
const t = useTranslations(locale);
const basePath = unlocalizePath(Astro.url.pathname);

function hrefFor(l: Locale): string {
  if (!alternates) return localizePath(basePath, l);
  // Pages with explicit alternates (posts, projects, 404) list only real URLs.
  return alternates[l] ?? localizePath('/', l);
}

const languages = LOCALES.map((l) => ({
  locale: l,
  name: t(`lang.${l}`),
  href: hrefFor(l),
  current: l === locale,
}));

/** Small inline flags (16x11), as on the old site. English uses the US flag like before. */
const FLAGS: Record<Locale, string> = {
  de: '<rect width="5" height="3" fill="#ffce00"/><rect width="5" height="2" fill="#d00"/><rect width="5" height="1" fill="#000"/>',
  en: '<rect width="16" height="13" fill="#fff"/><path d="M0 0h16v1H0zm0 2h16v1H0zm0 2h16v1H0zm0 2h16v1H0zm0 2h16v1H0zm0 2h16v1H0zm0 2h16v1H0z" fill="#b22234"/><rect width="7" height="7" fill="#3c3b6e"/>',
  fr: '<rect width="3" height="2" fill="#ef4135"/><rect width="2" height="2" fill="#fff"/><rect width="1" height="2" fill="#0055a4"/>',
};
const FLAG_VIEWBOX: Record<Locale, string> = { de: '0 0 5 3', en: '0 0 16 13', fr: '0 0 3 2' };
---

<details class:list={['lang', `lang--${placement}`]} data-lang-switcher>
  <summary class="lang__toggle">
    <span class="visually-hidden">{t('nav.language')}: </span>
    <svg class="lang__flag" viewBox={FLAG_VIEWBOX[locale]} preserveAspectRatio="none" aria-hidden="true" focusable="false" set:html={FLAGS[locale]} />
    <span>{t(`lang.${locale}`)}</span>
    <svg class="lang__caret" viewBox="0 0 10 6" aria-hidden="true" focusable="false"><path d="M0 0h10L5 6z" fill="currentColor"></path></svg>
  </summary>
  <ul class="lang__menu">
    {
      languages.map((lang) => (
        <li>
          <a
            href={lang.href}
            hreflang={lang.locale}
            lang={lang.locale}
            aria-current={lang.current ? 'page' : undefined}
            class="lang__link"
          >
            <svg class="lang__flag" viewBox={FLAG_VIEWBOX[lang.locale]} preserveAspectRatio="none" aria-hidden="true" focusable="false" set:html={FLAGS[lang.locale]} />
            {lang.name}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  // Close open language menus on Escape or on a click outside them.
  document.addEventListener('click', (event) => {
    for (const el of document.querySelectorAll<HTMLDetailsElement>('[data-lang-switcher][open]')) {
      if (!el.contains(event.target as Node)) el.open = false;
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const el of document.querySelectorAll<HTMLDetailsElement>('[data-lang-switcher][open]')) {
      el.open = false;
      el.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .lang {
    position: relative;
  }

  .lang__toggle {
    display: inline-flex;
    gap: 0.5em;
    align-items: center;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .lang__toggle::-webkit-details-marker {
    display: none;
  }

  .lang__flag {
    width: 16px;
    height: 11px;
  }

  .lang__caret {
    width: 0.6em;
    height: auto;
    transition: transform 0.2s ease;
  }

  .lang[open] .lang__caret {
    transform: rotate(180deg);
  }

  .lang__menu {
    margin: 0;
    padding: 0.25rem 0;
    list-style: none;
  }

  .lang--dropdown .lang__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 10;
    min-width: 10rem;
    border-radius: var(--radius-small);
    background: var(--color-bg);
    box-shadow: var(--shadow);
  }

  .lang__link {
    display: flex;
    gap: 0.75em;
    align-items: center;
    padding: 0.6em 1em;
    color: inherit;
  }

  .lang__link[aria-current='page'] {
    font-weight: 700;
  }
</style>
