---
/**
 * Link card for a Facebook post. Replaces the Facebook post plugin iframe, which set
 * third-party cookies (decision 5).
 *
 *   <FacebookPost href="https://www.facebook.com/wewater.org/posts/3746780992061441" />
 */
import { getLocale, useTranslations } from '@/i18n';

interface Props {
  /** URL of the post on facebook.com. */
  href: string;
  /** Optional short description shown on the card. */
  text?: string | undefined;
}

const { href, text } = Astro.props;
const t = useTranslations(getLocale(Astro.currentLocale));
---

<a
  href={href}
  rel="noopener"
  class="card bg-surface not-prose mx-auto my-8 flex w-full max-w-(--container-prose) flex-row items-center gap-4 p-5 no-underline transition-[translate,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-overlay"
>
  <span class="bg-accent text-accent-foreground grid size-12 shrink-0 place-items-center rounded-full" aria-hidden="true">
    <svg viewBox="0 0 24 24" class="size-6" fill="currentColor">
      <path d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H8.1v3h2.5V21z" />
    </svg>
  </span>
  <span class="flex flex-col gap-1">
    <span class="font-semibold">{t('content.facebook.title')}</span>
    {text && <span class="text-muted text-sm">{text}</span>}
    <span class="text-link text-sm font-medium">{t('content.facebook.cta')} →</span>
  </span>
</a>
