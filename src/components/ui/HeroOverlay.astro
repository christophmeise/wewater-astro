---
/**
 * Full-width hero: photo (or looping video) with overlaid content and the white wave at the bottom.
 * Replaces the old HeaderOverlay, HeaderOverlayBackground, HeaderOverlayFlexend, HeaderOverlayBlog,
 * HeaderOverlayBlogPost and VideoOverlay components.
 *
 *   <HeroOverlay image={hero} alt="" width={10}>
 *     <h1 class="hero-headline">WeWater</h1>
 *   </HeroOverlay>
 *
 *   <HeroOverlay image={poster} video={{ mp4: '/videos/filter.mp4', mp4Mobile: '/videos/filter-mobile.mp4' }} mobileAlign="top">…</HeroOverlay>
 *
 * Images: AVIF + WebP in a responsive srcset, JPEG/PNG fallback. The hero is normally the LCP
 * element, so it loads eagerly with fetchpriority="high" (`priority`, default true). Pass
 * priority={false} for heroes further down the page (variant="background").
 *
 * Video: the <picture> stays underneath as the poster and LCP element; the muted, looping video
 * plays on top once it has data. The `*Mobile` sources are used up to 768px wide, like the old site.
 * With prefers-reduced-motion the video is hidden and the photo is shown.
 *
 * Content typography: use the global .hero-headline / .hero-subheadline classes (and their
 * --inverted modifiers for white text on photos), see src/styles/global.css.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Photo; also the poster for `video`. */
  image: ImageMetadata;
  /** Different crop for phones (≤767px). */
  imageMobile?: ImageMetadata | undefined;
  /** Alt text. Default "" (decorative), which is right when the overlaid text says it all. */
  alt?: string | undefined;
  /** Looping background video (URLs of files in public/). */
  video?:
    | { mp4: string; webm?: string | undefined; mp4Mobile?: string | undefined; webmMobile?: string | undefined }
    | undefined;
  /**
   * default    – 900px high (full screen on phones), content vertically centred
   * flexend    – content near the bottom
   * background – like default, for use further down a page; set `backgroundColor`
   * blog       – shorter, below the header, darkened, content bottom-centred, no wave
   * blog-post  – 500px card inside the container, darkened, no wave
   */
  variant?: 'default' | 'flexend' | 'background' | 'blog' | 'blog-post' | undefined;
  /** Content width on tablet/desktop in 16ths of the container (the old Semantic grid). */
  width?: number | undefined;
  /** Put the content on the right (the old `floatRight`). */
  align?: 'start' | 'end' | undefined;
  /** On phones: centre the content vertically, or put it at the top, centred (the old `floatTop`). */
  mobileAlign?: 'center' | 'top' | undefined;
  /** Dark overlay over the photo for text contrast. Always on for the blog variants. */
  darken?: boolean | undefined;
  /** CSS object-position of the photo, e.g. "top". */
  objectPosition?: string | undefined;
  /** Shown behind the photo while it loads. */
  backgroundColor?: string | undefined;
  /** White wave at the bottom. Default: on, except for the blog variants. */
  wave?: boolean | undefined;
  /** Eager, high-priority image loading. Default true. */
  priority?: boolean | undefined;
  class?: string | undefined;
}

const {
  image,
  imageMobile,
  alt = '',
  video,
  variant = 'default',
  align = 'start',
  mobileAlign = 'center',
  objectPosition,
  backgroundColor,
  priority = true,
  class: className,
} = Astro.props;

const isBlog = variant === 'blog' || variant === 'blog-post';
const width = Astro.props.width ?? (variant === 'flexend' || isBlog ? 16 : 8);
const darken = Astro.props.darken ?? isBlog;
const wave = Astro.props.wave ?? !isBlog;

const WIDTHS = [480, 640, 828, 1080, 1280, 1600, 1920, 2560];

async function sources(src: ImageMetadata) {
  const widths = WIDTHS.filter((w) => w < src.width).concat(Math.min(src.width, 2560));
  const [avif, webp] = await Promise.all(
    (['avif', 'webp'] as const).map((format) => getImage({ src, widths, format, sizes: '100vw' })),
  );
  return { avif: avif!.srcSet.attribute, webp: webp!.srcSet.attribute };
}

const desktop = await sources(image);
const mobile = imageMobile ? await sources(imageMobile) : undefined;
const fallback = await getImage({
  src: image,
  width: Math.min(image.width, 1280),
  format: image.format === 'png' ? 'png' : 'jpg',
  layout: 'none',
});
const MOBILE = '(max-width: 767px)';
const VIDEO_MOBILE = '(max-width: 768px)';
---

<div
  class:list={[
    'hero',
    `hero--${variant}`,
    `hero--align-${align}`,
    `hero--mobile-${mobileAlign}`,
    { 'hero--darken': darken },
    className,
  ]}
  style={backgroundColor ? `--hero-bg: ${backgroundColor}` : undefined}
>
  <div class="hero__frame">
    <picture class="hero__media">
      {mobile && <source media={MOBILE} type="image/avif" srcset={mobile.avif} sizes="100vw" />}
      {mobile && <source media={MOBILE} type="image/webp" srcset={mobile.webp} sizes="100vw" />}
      <source type="image/avif" srcset={desktop.avif} sizes="100vw" />
      <source type="image/webp" srcset={desktop.webp} sizes="100vw" />
      <img
        src={fallback.src}
        alt={alt}
        width={image.width}
        height={image.height}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        style={objectPosition ? `object-position: ${objectPosition}` : undefined}
      />
    </picture>
    {
      video && (
        <video class="hero__video" autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1">
          {video.webmMobile && <source media={VIDEO_MOBILE} src={video.webmMobile} type="video/webm" />}
          {video.mp4Mobile && <source media={VIDEO_MOBILE} src={video.mp4Mobile} type="video/mp4" />}
          {video.webm && <source src={video.webm} type="video/webm" />}
          <source src={video.mp4} type="video/mp4" />
        </video>
      )
    }
    <div class="container hero__container">
      <div class="hero__content" style={`--hero-cols: ${width}`}>
        <slot />
      </div>
    </div>
  </div>
  {
    wave && (
      <svg class="hero__wave" viewBox="0 0 1440 150" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path
          fill="#fff"
          fill-rule="evenodd"
          d="M1440 90.8571L1380 98.4286C1320 106 1200 121.143 1080 113.571C960 106 840 75.7143 720 71.9286C600 68.1429 480 90.8571 360 83.2857C240 75.7143 120 37.8571 60 18.9286L0 0V159H60C120 159 240 159 360 159C480 159 600 159 720 159C840 159 960 159 1080 159C1200 159 1320 159 1380 159H1440V90.8571Z"
        />
      </svg>
    )
  }
</div>

<style>
  .hero {
    position: relative;
    display: flex;
    height: 900px;
    max-height: 100vh;
    background-color: var(--hero-bg, var(--color-bg-secondary));
    overflow: hidden;
  }

  .hero__frame {
    position: relative;
    display: flex;
    width: 100%;
  }

  .hero__media img,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero--darken .hero__frame::after {
    position: absolute;
    inset: 0;
    background: rgb(0 6 30 / 45%);
    content: '';
  }

  .hero__container {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
  }

  .hero__content {
    width: 100%;
    padding: 1rem;
  }

  /* Large display text over a photo keeps the light brand blue, as on the old site. */
  .hero__content :global(.hero-headline:not(.hero-headline--inverted)) {
    color: var(--color-primary);
  }

  .hero__wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    z-index: 2;
    width: 100%;
    height: auto;
    aspect-ratio: 1440 / 150;
  }

  /* Variants */
  .hero--flexend .hero__container {
    align-items: flex-end;
    height: 80%;
  }

  .hero--blog {
    height: 750px;
    max-height: 90vh;
    margin-top: var(--header-height);
  }

  .hero--blog .hero__container {
    align-items: flex-end;
    padding-bottom: 3rem;
    text-align: center;
  }

  .hero--blog-post {
    width: min(100% - 2 * var(--gutter), var(--container));
    height: 500px;
    margin: calc(var(--header-height) + 3rem) auto 0;
    border-radius: var(--radius);
  }

  .hero--blog-post .hero__container {
    align-items: stretch;
  }

  .hero--blog-post .hero__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 50px;
  }

  @media (width >= 768px) {
    .hero__content {
      width: calc(var(--hero-cols) / 16 * 100%);
    }

    .hero--align-end .hero__content {
      margin-left: auto;
    }
  }

  @media (width <= 767px) {
    .hero:is(.hero--default, .hero--flexend, .hero--background) {
      height: 100vh;
      height: 100svh;
    }

    .hero--blog {
      max-height: 70vh;
    }

    .hero--mobile-top .hero__container {
      align-items: flex-start;
      padding-top: 85px;
      text-align: center;
    }

    .hero--blog-post .hero__content {
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }
</style>
