---
/**
 * Inline SVG icon, rendered at build time (no JS, no icon font).
 * Sized by font-size: 1em high, width from the icon's aspect ratio. Colour = currentColor.
 *
 *   <Icon name="facebook" />                      decorative (aria-hidden)
 *   <Icon name="mail" label="E-Mail" />           meaningful on its own (role="img")
 *
 * Available names are the keys of ./icons.ts.
 */
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  /** Accessible name. Omit for decorative icons next to visible text. */
  label?: string | undefined;
  class?: string | undefined;
}

const { name, label, class: className } = Astro.props;
const { viewBox, body } = icons[name];
const [, , w = 1, h = 1] = viewBox.split(' ').map(Number);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  class:list={['icon', className]}
  style={`--icon-ratio: ${Math.round((w / h) * 1000) / 1000}`}
  fill="currentColor"
  focusable="false"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={body}
/>

<style>
  .icon {
    display: inline-block;
    flex-shrink: 0;
    width: calc(1em * var(--icon-ratio, 1));
    height: 1em;
    vertical-align: -0.125em;
  }
</style>
