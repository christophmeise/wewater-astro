---
/**
 * The WeWater logo (drop in two hands + wordmark), square.
 * PNG source (no SVG version exists yet; replace src/assets/site/logo.png when one does),
 * served as optimised WebP at 1x and 2x of 64px. Display size comes from `class`
 * (default `size-14`); keep it at or below 4rem.
 *
 *   <Logo alt="" />                                   inside a link that names the target
 *   <Logo alt="WeWater" class="size-11 md:size-14" loading="eager" />
 */
import { Image } from 'astro:assets';
import logo from '@/assets/site/logo.png';

interface Props {
  /** Use "" when a surrounding link or text already names it. */
  alt: string;
  loading?: 'eager' | 'lazy' | undefined;
  /** Size utilities, e.g. "size-12". Default "size-14". */
  class?: string | undefined;
}

const { alt, loading = 'lazy', class: className = 'size-14' } = Astro.props;
---

<Image src={logo} alt={alt} width={64} height={64} layout="fixed" loading={loading} decoding="async" class:list={['block', className]} />
