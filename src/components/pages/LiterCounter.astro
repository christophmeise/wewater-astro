---
/**
 * Litre counter for the home hero: "62.539.079,80 Liter Trinkwasser werden pro Jahr gespendet".
 * The number is rendered at build time and kept current by a tiny script (one tick per second,
 * as on the old site; no ticking with prefers-reduced-motion). The info button opens a native
 * popover with how the number is calculated: no JavaScript needed for it.
 *
 *   <LiterCounter locale={locale} />
 *
 * White text: place it on a photo or a dark surface.
 */
import { useTranslations, type Locale } from '@/i18n';
import { litersAt } from './liters';

interface Props {
  locale: Locale;
  class?: string | undefined;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
const format = new Intl.NumberFormat(locale, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const id = 'liter-counter-info';
---

<div class:list={['flex flex-col gap-1', className]}>
  <p class="eyebrow text-accent">{t('home.counter.kicker')}</p>
  <div class="flex items-end gap-3">
    <p class="flex flex-col gap-1">
      <span class="heading-1 tabular-nums" data-liters data-locale={locale}>{format.format(litersAt(Date.now()))}</span>
      <span class="text-sm text-white/90">{t('home.counter.label')}</span>
    </p>
    <button
      type="button"
      popovertarget={id}
      class="liter-info-button grid size-8 shrink-0 cursor-pointer place-items-center rounded-full border-2 border-white/70 text-white transition-colors hover:bg-white/15"
    >
      <span class="sr-only">{t('home.counter.infoLabel')}</span>
      <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true" focusable="false">
        <circle cx="12" cy="6" r="2"></circle>
        <path d="M10 10h3.5v9H16v2H8v-2h2.5v-7H10z"></path>
      </svg>
    </button>
  </div>
  <div id={id} popover class="liter-info bg-background text-foreground shadow-overlay max-w-sm rounded-2xl p-5 text-sm">
    {t('home.counter.info')}
  </div>
</div>

<style>
  .liter-info-button {
    anchor-name: --liter-info;
  }

  /* Next to the button where anchor positioning is supported; otherwise centred (UA default). */
  @supports (position-anchor: --liter-info) {
    .liter-info {
      position-anchor: --liter-info;
      inset: auto;
      top: anchor(bottom);
      left: anchor(left);
      margin: 0.5rem 0 0;
      position-try-fallbacks: flip-block, flip-inline;
    }
  }

  .liter-info::backdrop {
    background: transparent;
  }
</style>

<script>
  import { LITERS_PER_TICK, litersAt } from './liters';

  for (const el of document.querySelectorAll<HTMLElement>('[data-liters]')) {
    const format = new Intl.NumberFormat(el.dataset['locale'], { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    let liters = litersAt(Date.now());
    const render = () => {
      el.textContent = format.format(liters);
    };
    render();
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => {
        liters += LITERS_PER_TICK;
        render();
      }, 1000);
    }
  }
</script>
