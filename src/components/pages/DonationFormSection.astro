---
/**
 * Closing section of /spenden/einmalig/ and /spenden/monatlich/: "Spende jetzt", the four trust
 * points from /spenden/ and the betterplace form. The trust points also keep the form well below
 * the first screen, which it needs because it lazy-loads near the viewport (PLAN.md decision 1).
 *
 *   <DonationFormSection locale={locale} />
 *
 * The section has id="spendenformular" so a page can link to it (<a href="#spendenformular">).
 */
import Section from '@/components/ui/Section.astro';
import { useTranslations, type Locale } from '@/i18n';
import DonationFormSlot from './DonationFormSlot.astro';
import IconList from './IconList.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const trust = [t('spenden.trust1'), t('spenden.trust2'), t('spenden.trust3'), t('spenden.trust4')];
---

<Section id="spendenformular" class="flex flex-col items-center gap-10" aria-labelledby="donation-form-title">
  <SectionHeading id="donation-form-title" title={t('spenden.form.title')} align="center" />
  <IconList items={trust} class="max-w-(--container-prose)" />
  <DonationFormSlot />
</Section>
