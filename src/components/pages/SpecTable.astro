---
/**
 * Spec table (HeroUI `.table`): a label column plus one value column per product.
 * One product = a simple key/value sheet (product pages); several = a comparison with a
 * header row of product names, optional photos and links (/filtersystem/).
 *
 *   <SpecTable caption="Übersicht" rows={[{ label: 'Kosten', values: ['59 Euro je Stück'] }]} />
 *   <SpecTable caption="…" columns={[{ title: 'AQQAbag', href: '/filtersysteme/aqqabag/', image: bag }, …]} rows={…} />
 *
 * Values are HTML (they may contain links); build them from translated strings in the page.
 * The caption is for screen readers; show a visible heading above the table if needed.
 *
 * Phones: a key/value sheet stacks each label above its value (no squeezed second column).
 * A comparison becomes a list per row instead of a table (label, then each product's value),
 * so all products are visible without scrolling sideways; the table takes over from md.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { tableVariants } from '@heroui/styles';

interface Column {
  title: string;
  href?: string | undefined;
  image?: ImageMetadata | undefined;
}

interface Props {
  caption: string;
  columns?: Column[] | undefined;
  rows: { label: string; values: string[] }[];
  class?: string | undefined;
}

const { caption, columns, rows, class: className } = Astro.props;
const table = tableVariants({ variant: 'primary' });
const comparison = Boolean(columns && columns.length > 1);
---

{
  comparison && columns && (
    <dl class:list={['spec-list bg-surface shadow-surface divide-separator/50 divide-y rounded-3xl md:hidden', className]}>
      {rows.map((row) => (
        <div class="flex flex-col gap-3 px-5 py-4">
          <dt class="font-heading font-semibold">{row.label}</dt>
          <dd>
            <ul class="flex flex-col gap-2 text-sm">
              {columns.map((column, index) => (
                <li class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-x-3">
                  <span class="text-link font-semibold">{column.title}</span>
                  <span set:html={row.values[index]} />
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  )
}

<div class:list={[table.base(), 'spec', comparison ? 'spec--comparison max-md:hidden' : 'spec--sheet', className]}>
  <div
    class={table.scrollContainer()}
    tabindex={comparison ? 0 : undefined}
    role={comparison ? 'region' : undefined}
    aria-label={comparison ? caption : undefined}
  >
    <table class:list={[table.content(), comparison && 'min-w-176 table-fixed']}>
      <caption class="sr-only">{caption}</caption>
      {
        columns && (
          <thead class={table.header()}>
            <tr>
              <td class:list={[table.column(), comparison && 'w-1/5']} />
              {columns.map((column) => (
                <th scope="col" class:list={[table.column(), 'py-4 align-bottom']}>
                  <div class="flex flex-col gap-3">
                    {column.image && (
                      <Picture
                        src={column.image}
                        alt=""
                        formats={['avif', 'webp']}
                        width={360}
                        sizes="(min-width: 1200px) 15rem, 12rem"
                        class="aspect-4/3 w-full rounded-2xl object-cover"
                      />
                    )}
                    {column.href ? (
                      <a href={column.href} class="link-inline heading-3 no-underline hover:underline">
                        {column.title}
                      </a>
                    ) : (
                      <span class="heading-3 text-foreground">{column.title}</span>
                    )}
                  </div>
                </th>
              ))}
            </tr>
          </thead>
        )
      }
      <tbody class={table.body()}>
        {
          rows.map((row) => (
            <tr class={table.row()}>
              <th scope="row" class:list={[table.cell(), 'text-muted text-start align-top font-medium', !comparison && 'sm:w-2/5']}>
                {row.label}
              </th>
              {row.values.map((value) => (
                <td class:list={[table.cell(), 'align-top']} set:html={value} />
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  /* Long German words (Flüchtlingsunterkünfte) wrap instead of pushing the table wider. */
  .spec :is(th, td),
  .spec-list dd {
    hyphens: auto;
    hyphenate-limit-chars: 14 6 6;
    overflow-wrap: break-word;
  }

  /* The header row holds photos; HeroUI's short column separators would float next to them. */
  .spec .table__column::after {
    content: none;
  }

  /* Phones: a key/value sheet stacks each label above its value. */
  @media (width < 40rem) {
    .spec--sheet :is(table, tbody, tr, th, td) {
      display: block;
    }

    .spec--sheet table {
      border-radius: min(32px, var(--radius-2xl));
    }

    .spec--sheet :is(th, td) {
      border-radius: 0 !important;
    }

    .spec--sheet th {
      border-bottom: 0;
      padding-bottom: 0.125rem;
    }

    .spec--sheet td {
      padding-top: 0;
    }

    .spec--sheet tr:last-child td {
      border-bottom: 0;
    }
  }
</style>
