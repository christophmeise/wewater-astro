---
/**
 * WeWater's bank account for transfers and standing orders, in a soft box.
 *
 *   <BankDetails />
 *
 * The account itself is in ./links.ts (BANK); the footer shows the same account.
 * IBAN and BIC never break inside the number: on narrow phones the value moves below its label.
 */
import { BANK } from './links';

interface Props {
  class?: string | undefined;
}

const { class: className } = Astro.props;
const numbers = [
  { label: 'IBAN', value: BANK.iban },
  { label: 'BIC/SWIFT', value: BANK.bic },
];
---

<div class:list={['bg-background-secondary flex w-full max-w-md flex-col gap-2 rounded-2xl px-4 py-4 sm:px-5', className]}>
  <p>
    <strong class="font-semibold">{BANK.holder}</strong><br />
    {BANK.bank}
  </p>
  <dl class="grid gap-x-3 gap-y-1 sm:grid-cols-[auto_minmax(0,1fr)]">
    {
      numbers.map((number) => (
        <>
          <dt class="text-muted max-sm:text-sm">{number.label}</dt>
          <dd class="font-medium whitespace-nowrap tabular-nums max-sm:not-last:mb-1 max-[22.5rem]:text-sm">{number.value}</dd>
        </>
      ))
    }
  </dl>
</div>
