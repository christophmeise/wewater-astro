---
/**
 * PayPal "Spenden" button: a plain HTML form that posts to PayPal's hosted donate button
 * (same endpoint and button as the old site, but without PayPal's GIF button and tracking pixel).
 * PayPal's page then asks for the amount and, for monthly donations, the "monthly" checkbox.
 * The form target is allowed in the CSP (form-action https://www.paypal.com).
 *
 *   <PayPalDonateButton label={t('spenden.paypal.button')} />
 */
import Button from '@/components/ui/Button.astro';
import { PAYPAL_HOSTED_BUTTON_ID } from './links';
import PayPalIcon from './PayPalIcon.astro';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<form action="https://www.paypal.com/cgi-bin/webscr" method="post">
  <input type="hidden" name="cmd" value="_s-xclick" />
  <input type="hidden" name="hosted_button_id" value={PAYPAL_HOSTED_BUTTON_ID} />
  <Button type="submit" size="lg">
    <PayPalIcon />
    {label}
  </Button>
</form>
