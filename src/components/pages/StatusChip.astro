---
/**
 * Project status chip: "In Arbeit" (turning gears) or "Abgeschlossen" (check mark in a circle),
 * with the old site's animated lord-icons (<AnimatedIcon>, looping at random intervals as on the
 * old project cards). The icon lines take the chip's text colour, the accents stay brand blue.
 *
 *   <StatusChip status={project.data.status} locale="de" />
 *   <StatusChip status="completed" locale="en" tone="light" />    on photos
 */
import { chipVariants } from '@heroui/styles';
import AnimatedIcon from '@/components/ui/AnimatedIcon.astro';
import { useTranslations, type Locale } from '@/i18n';

interface Props {
  status: 'in-progress' | 'completed';
  locale: Locale;
  /** Default: soft tint (on white cards). light: white chip (on photos). */
  tone?: 'default' | 'light' | undefined;
  class?: string | undefined;
}

const { status, locale, tone = 'default', class: className } = Astro.props;
const t = useTranslations(locale);
const chip = chipVariants({ color: status === 'completed' ? 'success' : 'accent', variant: 'soft', size: 'lg' });
---

<span class:list={[chip.base(), 'gap-1.5', tone === 'light' && 'bg-background', className]}>
  <AnimatedIcon
    name={status === 'completed' ? 'thumb' : 'gears'}
    class="-my-1.5 -ms-1 size-7"
    primary="currentColor"
    secondary="var(--accent)"
    lineWidth="0.075rem"
    delay={3000}
    randomDelay={10000}
  />
  <span class={chip.label()}>{t(`content.status.${status}`)}</span>
</span>
