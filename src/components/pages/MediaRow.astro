---
/**
 * Image + text row: a rounded photo next to an eyebrow, title, text and actions.
 * Stacks on phones (photo first); side by side from md. Alternate rows with `reverse`.
 *
 *   <MediaRow image={bagPhoto} imageAlt={t('…')} eyebrow="AQQAbag" title={t('filtersystem.bag.title')}>
 *     <p>{t('filtersystem.bag.text')}</p>
 *     <Fragment slot="actions"><Button href="…">Mehr erfahren</Button></Fragment>
 *   </MediaRow>
 *
 * Put several rows in a flex column with a gap: <div class="flex flex-col gap-16 md:gap-24">.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  eyebrow?: string | undefined;
  title: string;
  /** Default h2. */
  titleTag?: 'h2' | 'h3' | undefined;
  /** Photo on the right (from md). */
  reverse?: boolean | undefined;
  /** Photo crop: landscape 4:3 (default) or the photo's own aspect ratio. */
  aspect?: 'landscape' | 'natural' | undefined;
  class?: string | undefined;
}

const { image, imageAlt, eyebrow, title, titleTag: TitleTag = 'h2', reverse = false, aspect = 'landscape', class: className } = Astro.props;
---

<div class:list={['grid items-center gap-6 md:grid-cols-12 md:gap-12', className]}>
  <Picture
    src={image}
    alt={imageAlt}
    formats={['avif', 'webp']}
    width={720}
    sizes="(min-width: 1200px) 30rem, (min-width: 768px) 42vw, 100vw"
    pictureAttributes={{ class: ['md:col-span-5', reverse && 'md:order-last'].filter(Boolean).join(' ') }}
    class:list={['shadow-surface w-full rounded-3xl object-cover', aspect === 'landscape' && 'aspect-4/3']}
  />
  <div class="flex flex-col gap-4 md:col-span-7">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <TitleTag class="heading-2">{title}</TitleTag>
    <div class="text-muted flex flex-col gap-3 text-lg">
      <slot />
    </div>
    {
      Astro.slots.has('actions') && (
        <div class="flex flex-wrap gap-3 pt-2">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</div>
