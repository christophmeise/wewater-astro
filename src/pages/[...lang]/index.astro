---
/**
 * Home page in all three languages: / (de), /en/, /fr/.
 * TEMPORARY placeholder (phase 1): only the hero, so the header-over-hero look can be
 * compared with the live site. Phase 3 ports the real home page and its strings.
 */
import heroImage from '@/assets/site/hero-home.jpg';
import Button from '@/components/ui/Button.astro';
import HeroOverlay from '@/components/ui/HeroOverlay.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getLocale, localeStaticPaths, localizePath, useTranslations } from '@/i18n';

export const getStaticPaths = localeStaticPaths;

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Placeholder copy from the old site's translation.json; moves into a strings group in phase 3.
const copy = {
  de: {
    claim: 'Wasser weltweit klarmachen.',
    text: 'Eine innovative Wasserfiltertechnologie ohne Einsatz elektrischer Energie oder Chemie, aber mit maximalem Reinheitsgrad.',
  },
  en: {
    claim: 'Clean water worldwide.',
    text: 'An innovative water filtration technology without need of electrical energy or chemicals, but with maximum purity.',
  },
  fr: {
    claim: "De l'eau potable pour tous.",
    text: "Une technologie innovante pour la filtration de l'eau sans nécessité d'énergie électrique ou de produits chimiques, mais avec un degré de pureté exceptionnel.",
  },
}[locale];
---

<BaseLayout title={t('site.name')}>
  <HeroOverlay image={heroImage} eyebrow={t('site.name')} title={copy.claim} lead={copy.text}>
    <Fragment slot="actions">
      <Button href={localizePath('/spenden/', locale)} size="lg" icon="tint">{t('nav.cta')}</Button>
    </Fragment>
  </HeroOverlay>
</BaseLayout>
