---
/**
 * Project: /projekte/<slug>/, /en/projekte/<slug>/, /fr/projekte/<slug>/ (each project only in its
 * own language; old cross-language URLs redirect, see public/_redirects).
 *
 * Photo hero with the status, then the MDX content (intro tiles, text, photos, galleries, the cost
 * table, the betterplace form), then "Projektupdates im Blog" and a link back to all projects.
 */
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Table from '@/components/content/Table.astro';
import PostCard from '@/components/pages/PostCard.astro';
import StatusChip from '@/components/pages/StatusChip.astro';
import Button from '@/components/ui/Button.astro';
import HeroOverlay from '@/components/ui/HeroOverlay.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localizePath, useTranslations, type Locale } from '@/i18n';
import { projectPaths, relatedPosts, translationsOf, type Project } from '@/lib/content';

export const getStaticPaths = projectPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const locale: Locale = data.lang;
const t = useTranslations(locale);
const alternates = await translationsOf(project);
const ogImage = await getImage({ src: data.hero, width: 1200, format: 'jpg' });
const related = await relatedPosts(project);

(Astro.locals as { contentMaxWidth?: number }).contentMaxWidth = 1200;
const { Content } = await render(project);
---

<BaseLayout title={data.title} description={data.description} alternates={alternates} image={ogImage.src}>
  <article>
    <HeroOverlay image={data.hero} alt={data.heroAlt} size="medium" position="bottom" overlay="dark" width="xl">
      <StatusChip slot="eyebrow" status={data.status} locale={locale} tone="light" />
      <span slot="title" class="heading-1 block text-white">{data.title}</span>
    </HeroOverlay>

    <Section class="flex flex-col gap-12">
      <div class="prose project-content max-w-none">
        <Content components={{ table: Table }} />
      </div>
      <div class="flex justify-center">
        <Button href={localizePath('/projekte/', locale)} variant="outline" icon="chevron-left">
          {t('projekte.allProjects')}
        </Button>
      </div>
    </Section>
  </article>

  {
    related.length > 0 && (
      <Section aria-labelledby="related-posts">
        <h2 id="related-posts" class="heading-2">
          {t('content.relatedPosts')}
        </h2>
        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {related.map((post) => (
            <li class="flex">
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      </Section>
    )
  }
</BaseLayout>
