---
/**
 * Blog post: /blog/<slug>/, /en/blog/<slug>/, /fr/blog/<slug>/ (each post only in its own language;
 * old cross-language URLs redirect, see public/_redirects).
 *
 * Hero card with categories, title, author, date and reading time; the text at a comfortable
 * reading width; author box; the frozen WordPress comments (read-only, decision 3); three more
 * posts in the same language.
 */
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import JsonLd from '@/components/JsonLd.astro';
import Table from '@/components/content/Table.astro';
import CategoryChips from '@/components/pages/CategoryChips.astro';
import PostCard from '@/components/pages/PostCard.astro';
import Button from '@/components/ui/Button.astro';
import HeroOverlay from '@/components/ui/HeroOverlay.astro';
import Section from '@/components/ui/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { authors } from '@/data/authors';
import { localizePath, useTranslations, type Locale } from '@/i18n';
import { formatDate } from '@/lib/format';
import { getPosts, postPaths, readingMinutes, translationsOf, type Post } from '@/lib/content';

export const getStaticPaths = postPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const locale: Locale = data.lang;
const t = useTranslations(locale);
const author = authors[data.author];
const bio = author.description[locale] ?? author.description.de;
const initials = author.name
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
const alternates = await translationsOf(post);
const ogImage = await getImage({ src: data.hero, width: 1200, format: 'jpg' });
const morePosts = (await getPosts(locale)).filter((p) => p.id !== post.id).slice(0, 3);

// Images in the text column are at most 42rem (672px) wide: let <Figure> pick smaller files.
(Astro.locals as { contentMaxWidth?: number }).contentMaxWidth = 672;
const { Content } = await render(post);

/** Replies are indented under their parent (up to three levels); WordPress keeps them in date order. */
const INDENT = ['', 'ms-6', 'ms-12', 'ms-18'];
const commentDepth = (id: number | undefined, depth = 0): number => {
  const parent = data.comments.find((c) => c.id === id);
  return parent ? commentDepth(parent.parentId, depth + 1) : depth;
};
---

<BaseLayout
  title={data.title}
  description={data.description ?? data.excerpt}
  alternates={alternates}
  image={ogImage.src}
  type="article"
>
  <article>
    <HeroOverlay image={data.hero} alt={data.heroAlt} inset size="medium" position="bottom" overlay="dark" width="full">
      <CategoryChips slot="eyebrow" categories={data.categories} locale={locale} tone="light" inline />
      {/* Hyphenate only long words, so product names such as "AQQAcube" are not split on phones. */}
      <span slot="title" class="heading-1 block text-white [hyphenate-limit-chars:10_4_4]">{data.title}</span>
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-white/90">
        <span>{t('content.by')} {author.name}</span>
        <span aria-hidden="true">·</span>
        <time datetime={data.date.toISOString()}>{formatDate(data.date, locale)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(post.body)} {t('content.minRead')}</span>
      </p>
    </HeroOverlay>

    {/* Half the usual section spacing above the text: the hero card already sets it apart. */}
    <Section class="flex flex-col gap-16" style="padding-top: calc(var(--space-section) / 2)">
      <div class="prose mx-auto w-full max-w-(--container-prose)">
        <Content components={{ table: Table }} />
      </div>

      <section
        class="bg-background-secondary mx-auto flex w-full max-w-(--container-prose) flex-col gap-5 rounded-3xl p-6 sm:flex-row sm:items-start md:p-8"
        aria-labelledby="about-author"
      >
        {
          author.avatar ? (
            <Image src={author.avatar} alt="" width={96} height={96} densities={[1, 2]} class="size-20 shrink-0 rounded-full object-cover md:size-24" />
          ) : (
            <span class="bg-accent text-accent-foreground grid size-20 shrink-0 place-items-center rounded-full text-2xl font-semibold md:size-24" aria-hidden="true">
              {initials}
            </span>
          )
        }
        <div class="flex flex-col gap-2">
          <p class="eyebrow">{t('content.aboutAuthor')}</p>
          <h2 id="about-author" class="heading-3">{author.name}</h2>
          {bio && <p class="text-muted" lang={author.description[locale] ? undefined : 'de'}>{bio}</p>}
        </div>
      </section>

      {
        data.comments.length > 0 && (
          <section class="mx-auto flex w-full max-w-(--container-prose) flex-col gap-6" aria-labelledby="comments">
            <h2 id="comments" class="heading-2">
              {data.comments.length} {t(data.comments.length === 1 ? 'blog.comment' : 'content.comments')}
            </h2>
            <ol class="flex flex-col gap-4">
              {data.comments.map((c) => (
                <li
                  id={`comment-${c.id}`}
                  class:list={['border-border flex flex-col gap-2 rounded-2xl border p-5', INDENT[Math.min(commentDepth(c.parentId), 3)]]}
                >
                  <p class="text-sm">
                    <strong class="font-semibold">{c.author}</strong> <span class="text-muted">{t('content.says')}</span>{' '}
                    <time class="text-muted" datetime={c.date.toISOString()}>
                      {formatDate(c.date, locale)}
                    </time>
                  </p>
                  <div class="prose prose-sm max-w-none" set:html={c.html} />
                </li>
              ))}
            </ol>
            <p class="text-muted text-sm">{t('content.commentsClosed')}</p>
          </section>
        )
      }
    </Section>
  </article>

  {
    morePosts.length > 0 && (
      <Section aria-labelledby="more-posts">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="more-posts" class="heading-2">
            {t('content.morePosts')}
          </h2>
          <Button href={localizePath('/blog/', locale)} variant="outline" icon="newspaper">
            {t('blog.allPosts')}
          </Button>
        </div>
        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {morePosts.map((p) => (
            <li class="flex">
              <PostCard post={p} />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <JsonLd type="blogPosting" post={post} image={ogImage.src} />
</BaseLayout>
