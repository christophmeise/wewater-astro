---
/**
 * Living design-system reference: tokens, typography roles and components.
 * Not linked from the site, excluded from the sitemap, noindex.
 * When you add a component or token to the design system, add an example here.
 */
import { getCollection } from 'astro:content';
import heroImage from '@/assets/site/hero-home.jpg';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
import FaqAccordion from '@/components/pages/FaqAccordion.astro';
import NewsletterForm from '@/components/pages/NewsletterForm.astro';
import AnimatedIcon from '@/components/ui/AnimatedIcon.astro';
import { ANIMATED_ICON_NAMES } from '@/components/ui/animated-icons';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import HeroOverlay from '@/components/ui/HeroOverlay.astro';
import Icon from '@/components/ui/Icon.astro';
import { icons, type IconName } from '@/components/ui/icons';
import Logo from '@/components/ui/Logo.astro';
import PlainHeader from '@/components/ui/PlainHeader.astro';
import Section from '@/components/ui/Section.astro';
import tutorialPoster from '@/assets/pages/tutorials/poster-intro.jpg';
import BankDetails from '@/components/pages/BankDetails.astro';
import DonationOptions from '@/components/pages/DonationOptions.astro';
import IconList from '@/components/pages/IconList.astro';
import LinkCard from '@/components/pages/LinkCard.astro';
import MediaRow from '@/components/pages/MediaRow.astro';
import Notice from '@/components/pages/Notice.astro';
import PayPalDonateButton from '@/components/pages/PayPalDonateButton.astro';
import SectionHeading from '@/components/pages/SectionHeading.astro';
import SpecTable from '@/components/pages/SpecTable.astro';
import Step from '@/components/pages/Step.astro';
import Steps from '@/components/pages/Steps.astro';
import YouTubeVideo from '@/components/pages/YouTubeVideo.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryChips from '@/components/pages/CategoryChips.astro';
import PostCard from '@/components/pages/PostCard.astro';
import ProjectCard from '@/components/pages/ProjectCard.astro';
import StatusChip from '@/components/pages/StatusChip.astro';
import { getPosts, getProjects } from '@/lib/content';
import { buttonVariants, chipVariants } from '@heroui/styles';

const iconNames = Object.keys(icons) as IconName[];
const faqSample = (await getCollection('faq', (entry) => entry.data.lang === 'de'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const [samplePost] = await getPosts('de');
const projects = await getProjects('de');
const sampleProject = projects[0];
const completedProject = projects.find((p) => p.data.status === 'completed');

const colors = [
  ['background', 'bg-background', 'Page background'],
  ['background-secondary', 'bg-background-secondary', 'Alternating sections (#F6F9FC)'],
  ['foreground', 'bg-foreground', 'Text, navy #000D3E'],
  ['muted', 'bg-muted', 'Secondary text'],
  ['accent', 'bg-accent', 'Brand blue #5ABEE6: buttons, highlights'],
  ['link', 'bg-link', 'Text-safe blue #1878A8: links, eyebrows'],
  ['brand-orange', 'bg-brand-orange', 'Category / decoration'],
  ['brand-violet', 'bg-brand-violet', 'Category / decoration'],
  ['brand-green', 'bg-brand-green', 'Category / decoration'],
  ['brand-pink', 'bg-brand-pink', 'Category / decoration'],
] as const;
---

<BaseLayout title="Styleguide" noindex alternates={{}}>
  <div class="container-page flex flex-col gap-16 pt-[calc(var(--header-height)+var(--space-section))]">
    <header class="flex flex-col gap-3">
      <p class="eyebrow">WeWater design system</p>
      <h1 class="heading-1">Styleguide</h1>
      <p class="lead max-w-(--container-prose)">
        Tokens and components every page is built from. Tailwind CSS v4 utilities plus HeroUI v3 component classes,
        compiled to static CSS.
      </p>
    </header>

    <section class="flex flex-col gap-6" aria-labelledby="sg-type">
      <h2 id="sg-type" class="heading-2">Typography</h2>
      <p class="text-display">Wasser weltweit klarmachen.</p>
      <p class="heading-1">Page title (heading-1)</p>
      <p class="heading-2">Section title (heading-2)</p>
      <p class="heading-3">Card title (heading-3)</p>
      <p class="eyebrow">Eyebrow above a section title</p>
      <p class="lead max-w-(--container-prose)">Lead paragraph. Introduces a section in one or two sentences.</p>
      <p class="max-w-(--container-prose)"> Body text at 16px with a 1.65 line height. Hinter WeWater steht ein engagiertes, überwiegend ehrenamtliches Team. Um unsere Projekte weltweit umzusetzen, sind wir auf Spenden angewiesen. <a class="link" href="/spenden/">Ein Link im Text</a>. </p>
      <p class="max-w-(--container-prose)"> Links inside running text that wraps over lines use <code>link-inline</code> (underlined, so they are not told apart by colour alone): <a class="link-inline" href="/unterstuetzen/">So kannst du uns auch ohne Spende unterstützen</a>. UI strings with inline links or bold text are written with tags (<code>&lt;docLink&gt;dieses Dokument&lt;/docLink&gt;</code>) and rendered with <code>rich()</code> from <code>src/i18n/rich.ts</code>. </p>
      <div class="prose" lang="de">
        <p class="not-prose eyebrow">prose</p>
        <h2>Long-form text (prose)</h2>
        <p>For legal pages, blog posts and projects: <code>&lt;div class="prose"&gt;</code> styles plain HTML or Markdown in the WeWater palette. <a href="/dataprotection/">Datenschutzerklärung</a>.</p>
        <ul><li>Lists, <strong>bold text</strong> and links</li><li>Headings from h2 down</li></ul>
      </div>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-colors">
      <h2 id="sg-colors" class="heading-2">Colours</h2>
      <ul class="grid grid-cols-[repeat(auto-fill,minmax(12rem,1fr))] gap-4">
        {
          colors.map(([name, cls, use]) => (
            <li class="card">
              <div class:list={['h-16 rounded-2xl border border-border', cls]} />
              <div class="card__header">
                <p class="font-semibold">{name}</p>
                <p class="text-muted text-sm">{use}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-buttons">
      <h2 id="sg-buttons" class="heading-2">Buttons</h2>
      <div class="flex flex-wrap items-center gap-3">
        <a class={buttonVariants({ variant: 'primary' })} href="/spenden/">Ich will helfen!</a>
        <a class={buttonVariants({ variant: 'secondary' })} href="/projekte/">Alle Projekte</a>
        <a class={buttonVariants({ variant: 'tertiary' })} href="/blog/">Zum Blog</a>
        <a class={buttonVariants({ variant: 'outline' })} href="/team/">Outline</a>
        <a class={buttonVariants({ variant: 'ghost' })} href="/faq/">Ghost</a>
        <a class={buttonVariants({ variant: 'primary', size: 'lg' })} href="/spenden/">Large</a>
        <a class={buttonVariants({ variant: 'primary', size: 'sm' })} href="/spenden/">Small</a>
      </div>
      <div class="bg-foreground flex flex-wrap gap-3 rounded-3xl p-6">
        <a class="button button--inverted" href="/projekte/">Inverted on dark</a>
      </div>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-chips">
      <h2 id="sg-chips" class="heading-2">Chips</h2>
      <div class="flex flex-wrap gap-2">
        <span class={chipVariants({}).base()}><span class="chip__label">AQQAcube</span></span>
        <span class={chipVariants({ color: 'accent' }).base()}><span class="chip__label">In Arbeit</span></span>
        <span class={chipVariants({ color: 'success' }).base()}><span class="chip__label">Abgeschlossen</span></span>
      </div>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-button">
      <h2 id="sg-button" class="heading-2">Button component</h2>
      <p class="max-w-(--container-prose)"> <code>&lt;Button&gt;</code> (<code>src/components/ui/Button.astro</code>) wraps the HeroUI button: <code>href</code> renders a link, otherwise a <code>&lt;button type="button"&gt;</code>. Props: <code>variant</code> (primary, secondary, tertiary, outline, ghost, inverted), <code>size</code> (sm, md, lg), <code>icon</code>, <code>fullWidth</code>, <code>iconOnly</code> (needs <code>aria-label</code>). </p>
      <div class="flex flex-wrap items-center gap-3">
        <Button href="/spenden/" icon="tint">Ich will helfen!</Button>
        <Button href="/blog/" variant="secondary" icon="newspaper">Alle News</Button>
        <Button variant="outline" icon="mail">Kontakt</Button>
        <Button variant="ghost" iconOnly icon="chevron-right" aria-label="Weiter" />
        <Button size="lg" href="/spenden/">Large</Button>
      </div>
      <div class="bg-foreground flex flex-wrap gap-3 rounded-3xl p-6">
        <Button variant="inverted" href="/projekte/" icon="grid">Alle Projekte</Button>
      </div>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-icons">
      <h2 id="sg-icons" class="heading-2">Icons</h2>
      <p class="max-w-(--container-prose)"> <code>&lt;Icon name="…" /&gt;</code> renders inline SVG at build time: 1em high, <code>currentColor</code>. Decorative by default; pass <code>label</code> when the icon stands alone. Add icons in <code>src/components/ui/icons.ts</code>. </p>
      <ul class="grid grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] gap-3">
        {
          iconNames.map((name) => (
            <li class="bg-background-secondary flex items-center gap-3 rounded-2xl p-3 text-sm">
              <Icon name={name} class="text-link text-2xl" />
              <code>{name}</code>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-animated-icons">
      <h2 id="sg-animated-icons" class="heading-2">Animated icons</h2>
      <p class="max-w-(--container-prose)"> <code>&lt;AnimatedIcon name="…" /&gt;</code> (<code>src/components/ui/AnimatedIcon.astro</code>): the old site's lord-icons. The first frame is inline SVG; the Lottie player (light build, loaded on demand) takes over once the icon is near the viewport and the visitor has interacted or the page has been idle for a few seconds. Static with <code>prefers-reduced-motion</code> and without JavaScript. Props: <code>name</code>, <code>trigger</code> (loop, hover), <code>delay</code> (ms between loops, default 2500), <code>randomDelay</code>, <code>primary</code> and <code>secondary</code> (CSS colours replacing navy/white and brand blue), <code>label</code>, <code>class</code> (size, default <code>size-20</code>). Files: <code>src/assets/animations/</code>, list in <code>animated-icons.ts</code>. </p>
      <ul class="grid grid-cols-[repeat(auto-fill,minmax(8rem,1fr))] gap-3">
        {
          ANIMATED_ICON_NAMES.map((name) => (
            <li class="bg-background-secondary flex flex-col items-center gap-2 rounded-2xl p-4 text-sm">
              <AnimatedIcon name={name} class={name === 'gears' || name === 'thumb' ? 'bg-foreground size-20 rounded-full' : 'size-20'} />
              <code>{name}</code>
            </li>
          ))
        }
      </ul>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/projekte/" class="bg-background-secondary hover:bg-default flex items-center gap-3 rounded-2xl p-3 pe-5 font-semibold transition-colors">
          <AnimatedIcon name="map" trigger="hover" class="size-12" />
          trigger="hover": plays when the link is hovered
        </a>
        <span class="text-link flex items-center gap-3 font-semibold">
          <AnimatedIcon name="pin" primary="currentColor" secondary="var(--color-brand-orange)" class="size-12" />
          primary="currentColor" secondary="var(--color-brand-orange)"
        </span>
      </div>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-logo">
      <h2 id="sg-logo" class="heading-2">Logo</h2>
      <p class="max-w-(--container-prose)"> <code>&lt;Logo alt="…" class="size-14" /&gt;</code>: optimised WebP (1x/2x). Size with <code>size-*</code> up to 4rem. Use <code>alt=""</code> inside a link that is already named. </p>
      <div class="flex items-end gap-6">
        <Logo alt="WeWater" class="size-16" />
        <Logo alt="WeWater" class="size-14" />
        <Logo alt="WeWater" class="size-12" />
      </div>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-cards">
      <h2 id="sg-cards" class="heading-2">Cards</h2>
      <p class="max-w-(--container-prose)"> <code>&lt;Card&gt;</code>: image, chip or eyebrow, title, meta, description. With <code>href</code> the whole card is one link. Props: <code>title</code>, <code>href</code>, <code>image</code>, <code>imageAlt</code>, <code>eyebrow</code>, <code>chip</code>, <code>meta</code>, <code>description</code>, <code>titleTag</code>, <code>variant</code>, <code>size</code> (<code>lg</code>: featured card), <code>sizes</code> (image width outside the 3-column grid), <code>priority</code> (eager image, only for the first card at the top of a page). Slots: default, <code>footer</code>, <code>chips</code> (custom chips above the title). </p>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <Card
          href="/blog/"
          image={heroImage}
          chip={{ label: 'Projekt-Update', color: 'accent' }}
          title="50 % weniger Krankheiten in Uvira"
          meta="12. März 2026 · 4 Min. Lesezeit"
          description="Was sauberes Trinkwasser für eine Schule im Osten des Kongo verändert hat."
        />
        <Card href="/projekte/" image={heroImage} eyebrow="AQQAcube · DR Kongo" title="Sauberes Wasser für Süd-Kivu">
          <Fragment slot="footer">
            <span class={chipVariants({ color: 'success' }).base()}><span class="chip__label">Abgeschlossen</span></span>
          </Fragment>
        </Card>
        <Card variant="secondary" title="Card without image" description="Secondary variant on white, e.g. for teasers in a sidebar." />
      </div>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-newsletter">
      <h2 id="sg-newsletter" class="heading-2">NewsletterForm</h2>
      <p class="max-w-(--container-prose)"> <code>&lt;NewsletterForm locale="de" /&gt;</code> (<code>src/components/pages/NewsletterForm.astro</code>): plain HTML form posting to Mailchimp, with HeroUI <code>textfield</code>, <code>label</code> and <code>input</code> styles, Mailchimp's hidden anti-spam field and a privacy note. The caller supplies the heading. Props: <code>locale</code>, <code>id</code> (unique per page), <code>layout</code> (stacked, inline). </p>
      <div class="grid items-start gap-6 md:grid-cols-[20rem_minmax(0,1fr)]">
        <Card variant="secondary" title="Jetzt für unseren Wassernewsletter anmelden">
          <NewsletterForm locale="de" id="sg-newsletter-stacked" />
        </Card>
        <div class="bg-background-secondary rounded-3xl p-6">
          <NewsletterForm locale="de" id="sg-newsletter-inline" layout="inline" />
        </div>
      </div>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-faq">
      <h2 id="sg-faq" class="heading-2">FaqAccordion</h2>
      <p class="max-w-(--container-prose)"> <code>&lt;FaqAccordion entries={'{…}'} locale="de" /&gt;</code> (<code>src/components/pages/FaqAccordion.astro</code>): HeroUI accordion classes (surface variant) on native <code>&lt;details&gt;</code>/<code>&lt;summary&gt;</code>, so it works without JavaScript. Renders entries of the <code>faq</code> collection; one question per <code>name</code> group is open at a time. </p>
      <FaqAccordion entries={faqSample} locale="de" name="sg-faq" class="max-w-(--container-prose)" />
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-content-cards">
      <h2 id="sg-content-cards" class="heading-2">Post and project cards</h2>
      <p class="max-w-(--container-prose)"> <code>&lt;PostCard post=&#123;post&#125; /&gt;</code> and <code>&lt;ProjectCard project=&#123;project&#125; /&gt;</code> (<code>src/components/pages/</code>), built on <code>&lt;Card&gt;</code>: hero image, chips, title, date in the entry's language, the whole card one link. Post chips: the first three categories with their colour dot (<code>&lt;CategoryChips&gt;</code>). Project chip: the status with its animated icon (<code>&lt;StatusChip&gt;</code>: turning gears or a check mark). Props: <code>titleTag</code>, <code>sizes</code>, <code>priority</code>; PostCard also <code>size="lg"</code> (featured, with excerpt). In a grid: <code>&lt;ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"&gt;</code> with each card in <code>&lt;li class="flex"&gt;</code>. </p>
      {
        samplePost && sampleProject && (
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            <li class="flex">
              <PostCard post={samplePost} />
            </li>
            <li class="flex">
              <ProjectCard project={sampleProject} />
            </li>
            <li class="flex">
              <ProjectCard project={completedProject ?? sampleProject} />
            </li>
          </ul>
        )
      }
      <div class="flex flex-wrap items-center gap-3">
        {samplePost && <CategoryChips categories={samplePost.data.categories} locale="de" />}
        <StatusChip status="in-progress" locale="de" />
        <StatusChip status="completed" locale="de" />
      </div>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-section">
      <h2 id="sg-section" class="heading-2">Section</h2>
      <p class="max-w-(--container-prose)"> <code>&lt;Section muted&gt;</code>: fluid vertical spacing, page container and a gap between children. <code>muted</code> gives the grey-blue band; <code>class</code> replaces the inner layout (e.g. a grid). </p>
    </section>
  </div>

  <Section muted class="grid gap-6 md:grid-cols-2">
    <p class="heading-3">A muted section</p>
    <p>Children sit in the page container; here as a two-column grid.</p>
  </Section>

  <div class="container-page flex flex-col gap-16 py-(--space-section)">
    <section class="flex flex-col gap-6" aria-labelledby="sg-hero">
      <h2 id="sg-hero" class="heading-2">HeroOverlay</h2>
      <p class="max-w-(--container-prose)"> Photo or video hero with the wave; the fixed header sits on top of it. Props: <code>image</code>, <code>imageMobile</code>, <code>video</code>, <code>eyebrow</code>, <code>title</code>, <code>lead</code> (or slots of the same name), <code>actions</code> slot, <code>size</code> (screen, large, medium), <code>align</code>, <code>position</code>, <code>width</code>, <code>overlay</code>, <code>inset</code>, <code>wave</code>, <code>belowHeader</code>, <code>priority</code>. The content sits between the fixed header and the wave with <code>--hero-space</code> of air on both sides; the hero only has a minimum height and grows on short screens instead of letting text run under the header or the wave. The page hero keeps <code>priority</code> (eager, high fetch priority); heroes lower on a page set <code>priority={'{false}'}</code> and <code>belowHeader={'{false}'}</code>. </p>
    </section>
  </div>

  <HeroOverlay
    image={heroImage}
    size="medium"
    priority={false}
    belowHeader={false}
    titleTag="p"
    eyebrow="size=medium"
    title="Wasser weltweit klarmachen."
    lead="Full-bleed hero with the gradient overlay and the wave."
  >
    <Fragment slot="actions">
      <Button href="/spenden/" icon="tint">Ich will helfen!</Button>
      <Button href="/blog/" variant="inverted" icon="newspaper">Alle News</Button>
    </Fragment>
  </HeroOverlay>

  <HeroOverlay
    image={heroImage}
    inset
    size="medium"
    position="bottom"
    overlay="dark"
    priority={false}
    belowHeader={false}
    titleTag="p"
    eyebrow="inset, position=bottom, overlay=dark"
    title="Blog post header"
  />

  <div class="container-page flex flex-col gap-16 py-(--space-section)">
    <section class="flex flex-col gap-6" aria-labelledby="sg-plain">
      <h2 id="sg-plain" class="heading-2">PlainHeader</h2>
      <p class="max-w-(--container-prose)"> Centred title for pages without a photo (FAQ, Impressum, …). Leaves room for the fixed header. Props: <code>eyebrow</code>, <code>title</code>, <code>lead</code>, <code>titleTag</code>; default slot below. </p>
      <div class="border-border rounded-3xl border pb-8">
        <PlainHeader titleTag="p" eyebrow="Hilfe" title="FAQ" lead="Häufig gestellte Fragen" />
      </div>
    </section>

    <section class="flex flex-col gap-10" aria-labelledby="sg-page">
      <div class="flex flex-col gap-3">
        <h2 id="sg-page" class="heading-2">Page components</h2>
        <p class="max-w-(--container-prose)"> Building blocks for the static pages, in <code>src/components/pages/</code>. Fixed link targets (PDFs, bank account, PayPal button, social profiles) are in <code>src/components/pages/links.ts</code>. </p>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="heading-3">SectionHeading</h3>
        <p class="text-muted max-w-(--container-prose) text-sm"> Eyebrow, title (h2 by default) and lead at the top of a section. Props: <code>eyebrow</code>, <code>title</code>, <code>lead</code> (or slots), <code>titleTag</code>, <code>id</code>, <code>align</code>. </p>
        <div class="border-border rounded-3xl border p-6">
          <SectionHeading titleTag="p" eyebrow="Werde Dauerspender*in" title="Deine Spende macht Wasser trinkbar" lead="Hinter WeWater steht ein engagiertes, überwiegend ehrenamtliches Team." />
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="heading-3">MediaRow</h3>
        <p class="text-muted max-w-(--container-prose) text-sm"> Image + text row (/filtersystem/). Props: <code>image</code>, <code>imageAlt</code>, <code>eyebrow</code>, <code>title</code>, <code>titleTag</code>, <code>reverse</code>, <code>aspect</code>; default slot for text, <code>actions</code> slot for buttons. </p>
        <MediaRow image={heroImage} imageAlt="" eyebrow="AQQAbag" title="Die Lösung für den Soforteinsatz" titleTag="h3">
          <p>Um kurzfristig den Bedarf an sicherem Wasser zu decken, kann der AQQAbag ein bis zwei Personen versorgen.</p>
          <Fragment slot="actions"><Button href="/filtersysteme/aqqabag/" icon="grid">Mehr erfahren<span class="sr-only">: AQQAbag</span></Button></Fragment>
        </MediaRow>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="heading-3">SpecTable</h3>
        <p class="text-muted max-w-(--container-prose) text-sm"> HeroUI table for spec sheets: one value column (product pages) or a comparison with <code>columns</code> (scrolls sideways on phones). Props: <code>caption</code> (screen readers), <code>rows</code> (<code>{'{ label, values: html[] }'}</code>), <code>columns</code> (<code>{'{ title, href?, image? }'}</code>). The filter specs come from <code>filterSpecs.ts</code>. </p>
        <SpecTable
          caption="Beispiel"
          columns={[{ title: 'AQQAbag' }, { title: 'AQQAcube' }]}
          rows={[
            { label: 'Anwendung', values: ['Sofortlösung (z.B. nach einer Umweltkatastrophe)', 'Sofortlösung'] },
            { label: 'Kosten', values: ['59 Euro je Stück', 'auf Anfrage'] },
          ]}
        />
      </div>

      <div class="grid gap-10 lg:grid-cols-2">
        <div class="flex flex-col gap-4">
          <h3 class="heading-3">IconList</h3>
          <p class="text-muted text-sm"> List with the same icon before each item. Props: <code>items</code> (HTML strings), <code>icon</code>. </p>
          <IconList items={['Unsere Gemeinnützigkeit ist vom Finanzamt anerkannt.', 'Wir halten unsere Kosten <strong>bewusst niedrig</strong>.']} />
        </div>
        <div class="flex flex-col gap-4">
          <h3 class="heading-3">Steps + Step</h3>
          <p class="text-muted text-sm"> Numbered options or steps (an <code>&lt;ol&gt;</code>; numbers follow the order). Step props: <code>title</code>, <code>titleTag</code>; content in the default slot. </p>
          <Steps>
            <Step title="Du spendest via PayPal." titleTag="h4"><PayPalDonateButton label="Mit PayPal spenden" /></Step>
            <Step title="Du spendest über eine Banküberweisung an" titleTag="h4"><BankDetails /></Step>
          </Steps>
        </div>
      </div>

      <div class="grid gap-10 lg:grid-cols-2">
        <div class="flex flex-col gap-4">
          <h3 class="heading-3">LinkCard</h3>
          <p class="text-muted text-sm"> A card that is one link (instead of social media embeds). Props: <code>href</code>, <code>icon</code>, <code>title</code>, <code>text</code>, <code>external</code> + <code>newTabLabel</code>. </p>
          <LinkCard href="https://www.instagram.com/wewater_org/" icon="instagram" title="Instagram" text="instagram.com/wewater_org" external newTabLabel="(öffnet in neuem Tab)" class="max-w-sm" />
        </div>
        <div class="flex flex-col gap-4">
          <h3 class="heading-3">Notice</h3>
          <p class="text-muted text-sm"> Short note (HeroUI alert). Props: <code>icon</code>, <code>title</code>, <code>status</code> (accent, default), <code>lang</code>. </p>
          <Notice icon="globe">This legal text is only available in German.</Notice>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="heading-3">DonationOptions</h3>
        <p class="text-muted max-w-(--container-prose) text-sm"> The three ways to give on /spenden/ (monthly, gift, one-off). Prop: <code>locale</code>. Renders its own h2 (screen readers only) and h3 per card. </p>
        <DonationOptions locale="de" />
      </div>

      <div class="grid gap-10 lg:grid-cols-2">
        <div class="flex flex-col gap-4">
          <h3 class="heading-3">YouTubeVideo</h3>
          <p class="text-muted text-sm"> Click-to-load YouTube facade (privacy-enhanced mode). Props: <code>id</code>, <code>title</code>, <code>playLabel</code>, <code>poster</code> (local image: then nothing is requested from YouTube before the click). </p>
          <YouTubeVideo id="YhAQGvI53-0" title="Vorstellung AQQAcube" playLabel="Video abspielen" poster={tutorialPoster} />
        </div>
        <div class="flex flex-col gap-4">
          <h3 class="heading-3">More</h3>
          <ul class="flex list-disc flex-col gap-2 ps-5 text-sm">
            <li><code>FilterSystemPage</code>: body of the AQQAbag/-cube/-system pages (video hero, spec table, text, photos).</li>
            <li><code>DonationFormSlot</code>: reserves the betterplace form's space (placeholder until <code>DonationForm</code> is wired).</li>
            <li><code>RelatedProjects</code>: projects using a filter system (placeholder, renders nothing yet).</li>
            <li><code>PayPalDonateButton</code>, <code>BankDetails</code>, <code>PayPalIcon</code>: donation helpers (see Steps above).</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="flex flex-col gap-6" aria-labelledby="sg-header">
      <h2 id="sg-header" class="heading-2">Header, mobile menu, language switcher, footer</h2>
      <ul class="flex max-w-(--container-prose) list-disc flex-col gap-2 ps-5">
        <li> <strong>Header</strong> (top of this page): fixed and translucent over heroes. From <code>lg</code> (1024px) the desktop bar with the Filtersysteme mega-menu (hover or keyboard focus, Escape closes); below it the mobile bar. </li>
        <li> <strong>Mobile menu</strong>: burger <code>&lt;button aria-expanded&gt;</code>, full-screen list. Without JavaScript it shows as a plain link list. </li>
        <li> <strong>Language switcher</strong>: <code>&lt;details&gt;</code> with plain links to this page in each language (BaseLayout <code>alternates</code>); missing translations link to that language's home page. </li>
        <li><strong>Footer</strong> (bottom of this page): wave, social links, three link columns, legal links.</li>
        <li>Navigation items live in <code>src/components/layout/navigation.ts</code>, texts in <code>nav.ts</code> / <code>footer.ts</code>.</li>
      </ul>
      <div class="bg-background-secondary w-full max-w-sm rounded-3xl px-4">
        <LanguageSwitcher locale="de" alternates={{}} placement="inline" />
      </div>
    </section>
  </div>
</BaseLayout>
